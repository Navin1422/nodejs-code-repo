generator client {
  provider = "prisma-client-js"
  //output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // provider = "mongodb"
  url      = env("DATABASE_URL")
  //directUrl = env("DIRECT_URL") - This is used only for operations that require a dedicated database connection
  // example , on env => DATABASE_URL="...pooler..."
  // DIRECT_URL="...direct..."
}

model User{
  id String @id @default(uuid()) // uuid() here means that prisma will automatically generate a random, 36-character alphanumeric string (such as 123e4567-e89b-12d3-a456-426614174000) to act as the unique primary key (@id) for that entry
  name String
  email String @unique
  password String 

  createdAt DateTime @default(now())
  
  movies Movie[] @relation("MovieCreator")
  watchlistItems WatchlistItem[]
}

model Movie {
  id String@id @default(uuid())
  title String
  overview String?
  releaseYear Int 
  genres String[] @default ([])
  runtime Int?
  posterUrl String?
  createdBy String
  createdAt DateTime @default (now())

  // Relations
  creator User @relation("MovieCreator",fields: [createdBy], references: [id], onDelete: Cascade)
  // createdBy is will be id of the user that created the movie
  watchlistItems WatchlistItem[] 
}

model WatchlistItem {
  id        String          @id @default(uuid())
  userId    String
  movieId   String
  status    WatchlistStatus @default(PLANNED)
  rating    Int?
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now())

  // Relations
  user User @relation(fields: [userId] , references: [id] , onDelete : Cascade)
  // @relation - used to establish relation between tables
  // fields: [userId] , references: [id] - field of userID in WatchlistItem references the field id in User table
  // onDelete : cascase = this means if the User table id user is deleted then autamatically that user's watchlistmovie should also be deleted
  movie Movie @relation(fields: [movieId] , references: [id] , onDelete : Cascade)
}

enum WatchlistStatus{
  PLANNED
  WATCHING
  COMPLETED
  DROPED
}

